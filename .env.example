# ---- Database (Postgres) ----
POSTGRES_USER=footconnect
POSTGRES_PASSWORD=footconnect
POSTGRES_DB=footconnect
# 55432 on the host avoids clashing with any native Postgres (which often
# occupies the 5432-5434 range). The container still listens on 5432 internally.
POSTGRES_PORT=55432
DATABASE_URL=postgresql://footconnect:footconnect@localhost:55432/footconnect?schema=public

# ---- Redis ----
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ---- API ----
API_PORT=4000
NODE_ENV=development
# Comma-separated allowed origins: Next dev (3000) + Expo web preview (8081).
CORS_ORIGIN=http://localhost:3000,http://localhost:8081

# ---- Web (Next.js) ----
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---- Mobile (Expo) ----
# `localhost` works for Expo web/iOS simulator. A physical phone needs this
# computer's LAN IPv4 address (for example http://192.168.1.20:4000). Android
# Emulator uses http://10.0.2.2:4000. Restart Expo after changing this value.
EXPO_PUBLIC_API_URL=http://localhost:4000
