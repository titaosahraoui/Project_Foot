# FootConnect Mobile Environment Variables
# - On web, "http://localhost:4000" connects to your computer directly.
# - On a physical phone (Expo Go), the app automatically resolves your computer's LAN IP
#   from Metro bundler (e.g. http://192.168.x.x:4000).
# - If you are not on the same Wi-Fi (e.g. 4G/cellular), run a tunnel (e.g. "npx localtunnel --port 4000"
#   or "ngrok http 4000") and paste the public HTTPS URL below:
#   EXPO_PUBLIC_API_URL=https://your-tunnel-name.loca.lt
EXPO_PUBLIC_API_URL=http://localhost:4000

# Bypass Expo dependency validation bug on Node 22 (Undici stream already read issue)
EXPO_NO_DEPENDENCY_VALIDATION=1
