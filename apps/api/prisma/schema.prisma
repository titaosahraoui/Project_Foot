// FootConnect base schema.
// Models are expanded per roadmap phase. Phase 0 ships only the User foundation.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  PLAYER
  PITCH_OWNER
  ADMIN
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  PRO
}

enum PlayerPosition {
  GK
  DEF
  MID
  FWD
  FLEX
}

model User {
  id           String          @id @default(uuid())
  email        String          @unique
  passwordHash String
  displayName  String
  roles        UserRole[]      @default([PLAYER])
  skillLevel   SkillLevel?
  position     PlayerPosition?
  lat          Float?
  lng          Float?
  bio          String?
  avatarUrl    String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  teamMemberships     TeamMembership[]
  invitationsReceived Invitation[]     @relation("invitee")
  invitationsSent     Invitation[]     @relation("inviter")
  pitches             Pitch[]
  refreshSessions     RefreshSession[]
  organizedChallenges MatchChallenge[]
  organizedBookings   Booking[]        @relation("organizedBookings")

  @@map("users")
}

model RefreshSession {
  jti           String    @id
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt     DateTime
  revokedAt     DateTime?
  replacedByJti String?
  createdAt     DateTime  @default(now())
  lastUsedAt    DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

enum PitchSurface {
  NATURAL_GRASS
  ARTIFICIAL_TURF
  INDOOR_PARQUET
  CONCRETE
}

enum PitchSize {
  FIVE_A_SIDE
  SEVEN_A_SIDE
  ELEVEN_A_SIDE
}

model Pitch {
  id               String       @id @default(uuid())
  ownerId          String
  owner            User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  address          String
  city             String
  lat              Float
  lng              Float
  surface          PitchSurface
  size             PitchSize
  priceAmountMinor Int
  currency         String       @default("DZD")
  amenities        String[]     @default([])
  photos           String[]     @default([])
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  availabilityRules PitchAvailabilityRule[]
  blocks            PitchBlock[]
  bookings          Booking[]

  @@map("pitches")
}

model PitchAvailabilityRule {
  id          String   @id @default(uuid())
  pitchId     String
  pitch       Pitch    @relation(fields: [pitchId], references: [id], onDelete: Cascade)
  dayOfWeek   Int // 0 = Sunday, 6 = Saturday
  startMinute Int // 0..1440
  endMinute   Int // 0..1440
  timezone    String   @default("Africa/Algiers")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([pitchId, dayOfWeek])
  @@map("pitch_availability_rules")
}

model PitchBlock {
  id          String    @id @default(uuid())
  pitchId     String
  pitch       Pitch     @relation(fields: [pitchId], references: [id], onDelete: Cascade)
  startAt     DateTime
  endAt       DateTime
  reason      String?
  createdById String
  createdAt   DateTime  @default(now())
  cancelledAt DateTime?

  @@index([pitchId, startAt, endAt])
  @@map("pitch_blocks")
}

enum TeamMemberRole {
  CAPTAIN
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  LEFT
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum TeamStatus {
  ACTIVE
  ARCHIVED
}

model Team {
  id        String     @id @default(uuid())
  name      String
  logoUrl   String?
  lat       Float?
  lng       Float?
  status    TeamStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  rating               TeamRating?
  members              TeamMembership[]
  invitations          Invitation[]
  lineups              TeamLineup[]
  availabilities       TeamAvailability[]
  challengerChallenges MatchChallenge[]   @relation("challengerChallenges")
  opponentChallenges   MatchChallenge[]   @relation("opponentChallenges")
  challengerBookings   Booking[]          @relation("challengerBookings")
  opponentBookings     Booking[]          @relation("opponentBookings")

  @@map("teams")
}

model TeamRating {
  teamId        String   @id
  team          Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  rating        Int      @default(1000)
  matchesPlayed Int      @default(0)
  wins          Int      @default(0)
  draws         Int      @default(0)
  losses        Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("team_ratings")
}

model TeamLineup {
  id            String           @id @default(uuid())
  teamId        String
  team          Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  format        String
  formationCode String
  updatedById   String
  updatedAt     DateTime         @updatedAt
  slots         TeamLineupSlot[]

  @@unique([teamId, format])
  @@map("team_lineups")
}

model TeamLineupSlot {
  id           String     @id @default(uuid())
  lineupId     String
  lineup       TeamLineup @relation(fields: [lineupId], references: [id], onDelete: Cascade)
  userId       String
  positionCode String
  sortOrder    Int

  @@unique([lineupId, sortOrder])
  @@unique([lineupId, userId])
  @@map("team_lineup_slots")
}

model TeamMembership {
  id       String           @id @default(uuid())
  team     Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId   String
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  role     TeamMemberRole   @default(MEMBER)
  status   MembershipStatus @default(ACTIVE)
  joinedAt DateTime         @default(now())

  @@unique([teamId, userId])
  @@map("team_memberships")
}

model Invitation {
  id          String           @id @default(uuid())
  team        Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId      String
  invitee     User             @relation("invitee", fields: [inviteeId], references: [id], onDelete: Cascade)
  inviteeId   String
  inviter     User             @relation("inviter", fields: [inviterId], references: [id], onDelete: Cascade)
  inviterId   String
  status      InvitationStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  @@unique([teamId, inviteeId])
  @@map("invitations")
}

// ---- Matchmaking (owned by the matchmaking module) ----

enum MatchFormat {
  FIVE_A_SIDE
  SEVEN_A_SIDE
  ELEVEN_A_SIDE
}

enum AvailabilityStatus {
  OPEN
  MATCHED
  CANCELLED
  EXPIRED
}

/// A captain-published looking-for-match window. Times are persisted in UTC.
/// The origin is private: API responses expose only an approximate area.
/// Range rules are also enforced by CHECK constraints in the migration.
model TeamAvailability {
  id           String             @id @default(uuid())
  teamId       String
  team         Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdById  String
  startAt      DateTime
  endAt        DateTime
  format       MatchFormat
  originLat    Float
  originLng    Float
  radiusKm     Int                @default(10)
  eloTolerance Int                @default(150)
  message      String?            @db.VarChar(280)
  status       AvailabilityStatus @default(OPEN)
  expiresAt    DateTime
  matchedAt    DateTime?
  cancelledAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  challengerChallenges MatchChallenge[]   @relation("challengerAvailabilityChallenges")
  opponentChallenges   MatchChallenge[]   @relation("opponentAvailabilityChallenges")

  @@index([teamId, status])
  @@index([status, startAt, endAt])
  @@index([status, expiresAt])
  @@map("team_availabilities")
}

enum ChallengeStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  EXPIRED
}

/// A proposed match between two teams based on overlapping availability.
/// Agreed window and geography are snapshotted on creation to preserve integrity.
model MatchChallenge {
  id                       String          @id @default(uuid())
  challengerTeamId         String
  opponentTeamId           String
  challengerAvailabilityId String
  opponentAvailabilityId   String
  organizerUserId          String
  format                   MatchFormat
  startAt                  DateTime
  endAt                    DateTime
  originLat                Float
  originLng                Float
  radiusKm                 Int
  responseDeadline         DateTime
  bookingDeadline          DateTime?
  status                   ChallengeStatus @default(PENDING)
  message                  String?         @db.VarChar(280)
  respondedAt              DateTime?
  cancelledAt              DateTime?
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  challengerTeam         Team             @relation("challengerChallenges", fields: [challengerTeamId], references: [id], onDelete: Cascade)
  opponentTeam           Team             @relation("opponentChallenges", fields: [opponentTeamId], references: [id], onDelete: Cascade)
  challengerAvailability TeamAvailability @relation("challengerAvailabilityChallenges", fields: [challengerAvailabilityId], references: [id], onDelete: Cascade)
  opponentAvailability   TeamAvailability @relation("opponentAvailabilityChallenges", fields: [opponentAvailabilityId], references: [id], onDelete: Cascade)
  organizerUser          User             @relation(fields: [organizerUserId], references: [id], onDelete: Cascade)
  bookings               Booking[]

  @@index([challengerTeamId, status])
  @@index([opponentTeamId, status])
  @@index([challengerAvailabilityId])
  @@index([opponentAvailabilityId])
  @@index([organizerUserId])
  @@index([status, responseDeadline])
  @@index([status, bookingDeadline])
  @@map("match_challenges")
}

// ---- Bookings (owned by the bookings module) ----

enum BookingStatus {
  PENDING_OWNER_CONFIRMATION
  CONFIRMED
  DECLINED
  CANCELLED_BY_TEAM
  CANCELLED_BY_OWNER
  EXPIRED
}

enum OfflinePaymentStatus {
  UNPAID
  PAID_AT_VENUE
  WAIVED
}

/// A requested or confirmed pitch reservation for an agreed challenge.
/// Snapshots agreed price and exact scheduled window.
/// Sequential attempts for one challenge are permitted, but at most one
/// blocking attempt (PENDING_OWNER_CONFIRMATION or CONFIRMED) exists at a time.
model Booking {
  id                    String               @id @default(uuid())
  pitchId               String
  challengeId           String
  organizerUserId       String
  challengerTeamId      String
  opponentTeamId        String
  startAt               DateTime
  endAt                 DateTime
  priceAmountMinor      Int
  currency              String               @default("DZD")
  status                BookingStatus        @default(PENDING_OWNER_CONFIRMATION)
  paymentStatus         OfflinePaymentStatus @default(UNPAID)
  ownerResponseDeadline DateTime
  confirmedAt           DateTime?
  declinedAt            DateTime?
  cancelledAt           DateTime?
  expiresAt             DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  pitch          Pitch          @relation(fields: [pitchId], references: [id], onDelete: Cascade)
  challenge      MatchChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  organizerUser  User           @relation("organizedBookings", fields: [organizerUserId], references: [id], onDelete: Cascade)
  challengerTeam Team           @relation("challengerBookings", fields: [challengerTeamId], references: [id], onDelete: Cascade)
  opponentTeam   Team           @relation("opponentBookings", fields: [opponentTeamId], references: [id], onDelete: Cascade)

  @@index([pitchId, status])
  @@index([challengeId])
  @@index([organizerUserId, status])
  @@index([challengerTeamId, status])
  @@index([opponentTeamId, status])
  @@index([status, ownerResponseDeadline])
  @@index([pitchId, startAt, endAt])
  @@map("bookings")
}

model IdempotencyRecord {
  id             String   @id @default(uuid())
  actorId        String
  scope          String
  key            String
  requestHash    String
  resourceType   String
  resourceId     String
  responseStatus Int
  responseBody   Json
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  @@unique([actorId, scope, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}
