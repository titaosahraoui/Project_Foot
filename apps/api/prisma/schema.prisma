// FootConnect base schema.
// Models are expanded per roadmap phase. Phase 0 ships only the User foundation.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PLAYER
  PITCH_OWNER
  ADMIN
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  PRO
}

enum PlayerPosition {
  GK
  DEF
  MID
  FWD
  FLEX
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String
  displayName  String
  roles        UserRole[]  @default([PLAYER])
  skillLevel   SkillLevel?
  position     PlayerPosition?
  lat          Float?
  lng          Float?
  bio          String?
  avatarUrl    String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  teamMemberships     TeamMembership[]
  invitationsReceived Invitation[]     @relation("invitee")
  invitationsSent     Invitation[]     @relation("inviter")
  pitches             Pitch[]
  refreshSessions     RefreshSession[]

  @@map("users")
}

model RefreshSession {
  jti           String   @id
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt     DateTime
  revokedAt     DateTime?
  replacedByJti String?
  createdAt     DateTime @default(now())
  lastUsedAt    DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

enum PitchSurface {
  NATURAL_GRASS
  ARTIFICIAL_TURF
  INDOOR_PARQUET
  CONCRETE
}

enum PitchSize {
  FIVE_A_SIDE
  SEVEN_A_SIDE
  ELEVEN_A_SIDE
}

model Pitch {
  id               String       @id @default(uuid())
  ownerId          String
  owner            User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  address          String
  city             String
  lat              Float
  lng              Float
  surface          PitchSurface
  size             PitchSize
  priceAmountMinor Int
  currency         String       @default("DZD")
  amenities        String[]     @default([])
  photos           String[]     @default([])
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  slots        PitchSlot[]

  @@map("pitches")
}

model PitchSlot {
  id         String   @id @default(uuid())
  pitchId    String
  pitch      Pitch    @relation(fields: [pitchId], references: [id], onDelete: Cascade)
  dayOfWeek  Int      // 0 = Sunday, 6 = Saturday
  startTime  String   // "09:00"
  endTime    String   // "10:00"
  isBookable Boolean  @default(true)

  @@unique([pitchId, dayOfWeek, startTime])
  @@map("pitch_slots")
}

enum TeamMemberRole {
  CAPTAIN
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  LEFT
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum TeamStatus {
  ACTIVE
  ARCHIVED
}

model Team {
  id          String           @id @default(uuid())
  name        String
  logoUrl     String?
  lat         Float?
  lng         Float?
  status      TeamStatus       @default(ACTIVE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  rating      TeamRating?
  members     TeamMembership[]
  invitations Invitation[]
  lineups     TeamLineup[]

  @@map("teams")
}

model TeamRating {
  teamId        String   @id
  team          Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  rating        Int      @default(1000)
  matchesPlayed Int      @default(0)
  wins          Int      @default(0)
  draws         Int      @default(0)
  losses        Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("team_ratings")
}

model TeamLineup {
  id            String           @id @default(uuid())
  teamId        String
  team          Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  format        String
  formationCode String
  updatedById   String
  updatedAt     DateTime         @updatedAt
  slots         TeamLineupSlot[]

  @@unique([teamId, format])
  @@map("team_lineups")
}

model TeamLineupSlot {
  id           String     @id @default(uuid())
  lineupId     String
  lineup       TeamLineup @relation(fields: [lineupId], references: [id], onDelete: Cascade)
  userId       String
  positionCode String
  sortOrder    Int

  @@unique([lineupId, sortOrder])
  @@unique([lineupId, userId])
  @@map("team_lineup_slots")
}

model TeamMembership {
  id       String           @id @default(uuid())
  team     Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId   String
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  role     TeamMemberRole   @default(MEMBER)
  status   MembershipStatus @default(ACTIVE)
  joinedAt DateTime         @default(now())

  @@unique([teamId, userId])
  @@map("team_memberships")
}

model Invitation {
  id          String           @id @default(uuid())
  team        Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId      String
  invitee     User             @relation("invitee", fields: [inviteeId], references: [id], onDelete: Cascade)
  inviteeId   String
  inviter     User             @relation("inviter", fields: [inviterId], references: [id], onDelete: Cascade)
  inviterId   String
  status      InvitationStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  @@unique([teamId, inviteeId])
  @@map("invitations")
}

model IdempotencyRecord {
  id             String   @id @default(uuid())
  actorId        String
  scope          String
  key            String
  requestHash    String
  resourceType   String
  resourceId     String
  responseStatus Int
  responseBody   Json
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  @@unique([actorId, scope, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}
